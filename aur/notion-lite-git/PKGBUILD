# Maintainer: Murilo Watanabe <mew290405r6 at gmail dot com>

pkgname=notion-lite-git
_pkgname=notion-lite
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Lightweight unofficial Notion client written in Rust (WebKitGTK, no Electron) - development version'
arch=('x86_64' 'aarch64')
url='https://github.com/MuriloWatanabe/notion-lite'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'libsoup3' 'cairo' 'gdk-pixbuf2' 'xdg-utils' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
optdepends=(
  'libnotify: notificação de downloads concluídos'
  'hunspell-en_us: correção ortográfica em inglês'
  'gst-plugins-good: áudio e vídeo embutidos nas páginas'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/notion-lite "$pkgdir/usr/bin/notion-lite"
  install -Dm644 assets/io.github.murilowatanabe.NotionLite.desktop \
    "$pkgdir/usr/share/applications/io.github.murilowatanabe.NotionLite.desktop"
  install -Dm644 assets/notion-lite.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/notion-lite.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
